      "id": "claude_code",
      "display_name": "Claude Code",
      "marker": "{home}/.claude",
      "skills_dir": "{home}/.claude/skills",
      "persona_file": "{home}/.claude/CLAUDE.md",
      "verified": true,
      "notes": "Alternative: install as a plugin (/plugin marketplace add ilang-ai/autocode). Use one route, not both, or the skills show up twice."
    },
